<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= __('access.title') %> · <%= __('app.title') %></title>
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico">
    <style>
        :root { color-scheme: light dark; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 16px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #f4f5fb;
            color: #1f2333;
        }
        .access {
            width: 100%;
            max-width: 380px;
            padding: 32px 28px;
            border-radius: 14px;
            background: #ffffff;
            border: 1px solid #e2e4ef;
            box-shadow: 0 10px 30px rgba(40, 40, 90, 0.08);
        }
        .access img { width: 48px; height: 48px; display: block; margin-bottom: 16px; }
        h1 { font-size: 1.25rem; margin: 0 0 8px; }
        p { margin: 0 0 20px; line-height: 1.45; color: #5b6075; font-size: 0.93rem; }
        label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }
        input {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #cdd0e0;
            font-size: 0.95rem;
            background: inherit;
            color: inherit;
        }
        input:focus { outline: 2px solid #7062f0; outline-offset: 1px; border-color: transparent; }
        button {
            margin-top: 16px;
            width: 100%;
            padding: 10px 12px;
            border: 0;
            border-radius: 8px;
            background: #6a5cf0;
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
        }
        button:hover { background: #5a4ce0; }
        .error {
            margin: 0 0 16px;
            padding: 8px 12px;
            border-radius: 8px;
            background: #fdecec;
            color: #a12626;
            font-size: 0.88rem;
        }
        @media (prefers-color-scheme: dark) {
            body { background: #12131c; color: #e7e8f2; }
            .access { background: #1b1d2a; border-color: #2c2f42; box-shadow: none; }
            p { color: #a3a7bd; }
            input { border-color: #3a3e55; }
            .error { background: #3a1d22; color: #f3a7a7; }
        }
    </style>
</head>
<body>
    <form class="access" method="post" action="/api/access/login">
        <img src="/images/favicon/android-chrome-192x192.png" alt="">
        <h1><%= __('access.title') %></h1>
        <p><%= __('access.intro') %></p>
        <% if (error) { %>
            <div class="error" role="alert"><%= __('access.wrong') %></div>
        <% } %>
        <label for="access-key"><%= __('access.keyLabel') %></label>
        <input id="access-key" name="key" type="password" autocomplete="current-password" required autofocus>
        <input type="hidden" name="next" value="<%= siguiente %>">
        <button type="submit"><%= __('access.submit') %></button>
    </form>
</body>
</html>
