<nav class="navbar-modern">
    <div class="d-flex align-items-center justify-content-between w-100">
        <a class="navbar-brand" href="/">
            <img src="/images/favicon/favicon-32x32.png" alt="logo" width="32" height="32">
            <span class="brand-text"><%= __('app.title') %></span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <!--
              Selector de entorno.
              Va en la barra y no en la cabecera de la tarjeta de rutas porque
              es estado global de la aplicación, como el idioma o el estado del
              servidor: decide contra qué se resuelven las variables de TODAS
              las rutas, no de la lista que estés mirando.
            -->
            <!-- Navegación y estado operativo: valen en cualquier pantalla, así
                 que su sitio es la barra y no la cabecera de la lista de rutas -->
            <a class="btn-nav-top<%= (typeof paginaActual !== 'undefined' && paginaActual === 'logs') ? ' is-current' : '' %>"
               href="/logs" title="<%= __('logs.title') %>">
                <i class="fa fa-stream"></i>
                <span class="btn-nav-label"><%= __('logs.title') %></span>
            </a>
            <button type="button" class="btn-nav-top"
                    onclick="typeof openList === 'function' ? openList() : (window.location.href = '/')"
                    title="<%= __('routes.pendingList') %>">
                <i class="fa fa-hourglass-half"></i>
                <span class="btn-nav-label"><%= __('routes.pendingList') %></span>
                <span id="pendingBadge" class="pending-badge" style="display: none;">0</span>
            </button>

            <div class="env-selector" id="envSelector">
                <button class="btn-env" type="button" onclick="EnvModule.toggle()" title="<%= __('env.switchHint') %>">
                    <i class="fa fa-layer-group"></i>
                    <span id="envActiveName">—</span>
                    <span class="env-warning-dot" id="envWarningDot" style="display: none;" title="<%= __('env.undefinedHint') %>"></span>
                    <i class="fa fa-chevron-down env-arrow"></i>
                </button>
                <div class="env-menu" id="envMenu">
                    <div class="env-menu-header"><%= __('env.switchTo') %></div>
                    <div id="envMenuList"></div>
                    <button type="button" class="env-menu-manage" onclick="EnvModule.openManager()">
                        <i class="fa fa-sliders-h"></i> <%= __('env.manage') %>
                    </button>
                </div>
            </div>

            <!-- Selector de idioma -->
            <div class="language-selector dropdown">
                <button class="btn-language dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="/images/flags/<%= locale %>.svg" alt="<%= locale %>" class="lang-flag-img">
                    <span class="lang-code"><%= locale.toUpperCase() %></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item <%= locale === 'es' ? 'active' : '' %>" href="/lang/es"><img src="/images/flags/es.svg" alt="ES" class="lang-flag-img"> <%= __('languages.es') %></a></li>
                    <li><a class="dropdown-item <%= locale === 'en' ? 'active' : '' %>" href="/lang/en"><img src="/images/flags/en.svg" alt="EN" class="lang-flag-img"> <%= __('languages.en') %></a></li>
                    <li><a class="dropdown-item <%= locale === 'gl' ? 'active' : '' %>" href="/lang/gl"><img src="/images/flags/gl.svg" alt="GL" class="lang-flag-img"> <%= __('languages.gl') %></a></li>
                </ul>
            </div>
            <!-- Estado del servidor -->
            <button class="navbar-status-btn" id="serverStatus" onclick="openConnectionModal()" title="<%= __('nav.viewStatus') %>">
                <span class="status-dot" id="statusDot"></span>
                <span id="statusText"><%= __('nav.connecting') %></span>
                <i class="fa fa-chevron-down status-arrow"></i>
            </button>
        </div>
    </div>
</nav>
