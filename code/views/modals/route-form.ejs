<!-- Modal Nueva/Editar Ruta -->
<div class="modal fade modal-modern" id="routesModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-fullwidth">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="titleModal"><i class="fa fa-route me-2"></i><%= __('routes.newRoute') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="idmodal" hidden></p>

        <div class="route-modal-layout">
          <!-- Panel de navegacion lateral -->
          <aside class="route-nav-panel" id="routeNavPanel">
            <div class="route-nav-header">
              <i class="fa fa-sitemap"></i>
              <span><%= __('form.navigationTree') %></span>
            </div>
            <div class="route-nav-tree" id="routeNavTree">
              <!-- Item: Respuesta Principal -->
              <div class="route-nav-item route-nav-main active" data-target="mainResponseSection" onclick="RouteNavigation.navigateTo('mainResponseSection')">
                <i class="fa fa-reply"></i>
                <span class="nav-item-name"><%= __('form.mainResponse') %></span>
              </div>

              <!-- Separador para Conditional Responses -->
              <div class="route-nav-divider" id="navDividerConditions">
                <span><%= __('form.conditionalResponses') %></span>
              </div>

              <!-- Contenedor sortable para items de condiciones -->
              <div class="route-nav-conditions" id="routeNavConditions">
                <!-- Items dinamicos insertados por JS -->
              </div>

              <!-- Separador para Proxy Fallbacks (oculto por defecto) -->
              <div class="route-nav-divider" id="navDividerFallbacks" style="display: none;">
                <span><%= __('form.proxyFallbacks') %></span>
              </div>

              <!-- Contenedor para fallbacks y sus criterios -->
              <div class="route-nav-fallbacks" id="routeNavFallbacks" style="display: none;">
                <!-- Items dinamicos insertados por JS -->
              </div>

              <!-- Separador para GraphQL Operations (oculto por defecto) -->
              <div class="route-nav-divider" id="navDividerGraphQL" style="display: none;">
                <span><%= __('form.graphqlOperations') %></span>
              </div>

              <!-- Contenedor para operaciones GraphQL -->
              <div class="route-nav-graphql" id="routeNavGraphQL" style="display: none;">
                <!-- Items dinamicos insertados por JS -->
              </div>

              <!-- Separador para WebSocket Messages (oculto por defecto) -->
              <div class="route-nav-divider" id="navDividerWebSocket" style="display: none;">
                <span><%= __('form.wsMessages') %></span>
              </div>

              <!-- Contenedor para mensajes WebSocket -->
              <div class="route-nav-websocket" id="routeNavWebSocket" style="display: none;">
                <!-- Items dinamicos insertados por JS -->
              </div>
            </div>
          </aside>

          <!-- Contenido principal -->
          <div class="route-content-panel" id="routeContentPanel">
            <!-- Seccion: Respuesta Principal -->
            <section class="route-section" id="mainResponseSection">
              <!-- Tipo de Respuesta -->
              <div class="form-group-modern" id="divtresp">
                <label class="form-label-modern" for="tiporespuesta"><%= __('form.responseType') %></label>
                <select class="form-control-modern form-select-modern" onchange="checkRespuesta()" id="tiporespuesta" name="tiporespuesta">
                  <option value="json" selected><%= __('responseTypes.json') %></option>
                  <option value="xml"><%= __('responseTypes.xml') %></option>
                  <option value="soap"><%= __('responseTypes.soap') %></option>
                  <option value="text"><%= __('responseTypes.text') %></option>
                  <option value="html"><%= __('responseTypes.html') %></option>
                  <option value="page"><%= __('responseTypes.page') %></option>
                  <option value="file"><%= __('responseTypes.file') %></option>
                  <option value="proxy"><%= __('responseTypes.proxy') %></option>
                  <option value="graphql"><%= __('responseTypes.graphql') %></option>
                  <option value="websocket"><%= __('responseTypes.websocket') %></option>
                  <option value="empty"><%= __('responseTypes.empty') %></option>
                </select>
              </div>

              <!-- Metodo HTTP -->
              <div class="form-group-modern" id="divtipo">
                <label class="form-label-modern" for="tipoSelect"><%= __('form.httpMethod') %></label>
                <select class="form-control-modern form-select-modern" id="tipoSelect" name="tipoSelect">
                  <option value="0" selected>GET</option>
                  <option value="1">POST</option>
                  <option value="2">PUT</option>
                  <option value="3">DELETE</option>
                  <option value="4">PATCH</option>
                  <option value="5">OPTIONS</option>
                  <option value="6">HEAD</option>
                  <option value="7">ANY</option>
                </select>
              </div>

              <!-- Ruta -->
              <div class="form-group-modern" id="divruta">
                <label class="form-label-modern" for="ruta"><%= __('form.route') %></label>
                <div class="input-group-modern">
                  <input type="text" class="form-control-modern" id="ruta" name="ruta" placeholder="<%= __('form.placeholder.route') %>"
                    oninput="validateRegexIfEnabled()">
                  <div class="input-addon">
                    <input class="form-check-input me-2" type="checkbox" id="isRegex" name="isRegex" onchange="toggleRegexMode()">
                    <label class="form-check-label" for="isRegex"><%= __('filters.regex') %></label>
                  </div>
                </div>
              </div>

              <!-- Validador Regex -->
              <div class="form-group-modern" id="divRegexValidator" style="display: none;">
                <label class="form-label-modern" for="regexTestUrl"><%= __('form.testRegex') %></label>
                <div class="input-group-modern">
                  <input type="text" class="form-control-modern" id="regexTestUrl" name="regexTestUrl" placeholder="<%= __('form.placeholder.testUrl') %>" oninput="testRegex()">
                  <button class="btn-modern btn-modern-secondary" type="button" onclick="testRegex()" style="border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;">
                    <%= __('buttons.validate') %>
                  </button>
                </div>
                <div id="regexResult" class="mt-2"></div>
              </div>

              <!-- Codigo de Respuesta -->
              <div class="form-group-modern" id="divcodresp">
                <label class="form-label-modern" for="crespuestaInput"><%= __('form.responseCode') %></label>
                <div class="d-flex gap-3 align-items-center">
                  <input type="text" class="form-control-modern" id="crespuestaInput" name="crespuestaInput" list="httpCodes" value="200"
                    oninput="updateCodeDescription()" autocomplete="off" style="max-width: 100px;">
                  <span id="codeDescription" style="color: var(--text-secondary);">OK</span>
                </div>
                <datalist id="httpCodes">
                  <option value="200">OK</option>
                  <option value="201">Created</option>
                  <option value="204">No Content</option>
                  <option value="301">Moved Permanently</option>
                  <option value="302">Found (Redirect)</option>
                  <option value="304">Not Modified</option>
                  <option value="400">Bad Request</option>
                  <option value="401">Unauthorized</option>
                  <option value="403">Forbidden</option>
                  <option value="404">Not Found</option>
                  <option value="405">Method Not Allowed</option>
                  <option value="409">Conflict</option>
                  <option value="422">Unprocessable Entity</option>
                  <option value="429">Too Many Requests</option>
                  <option value="500">Internal Server Error</option>
                  <option value="502">Bad Gateway</option>
                  <option value="503">Service Unavailable</option>
                  <option value="504">Gateway Timeout</option>
                </datalist>
              </div>

              <!-- Respuesta -->
              <div class="form-group-modern" id="divresp">
                <div class="form-label-row">
                  <label class="form-label-modern" for="respuesta"><%= __('form.response') %></label>
                  <button type="button" class="btn-modern btn-modern-secondary btn-sm" id="btnFormatJson" onclick="formatResponseJson()" title="<%= __('buttons.format') %>">
                    <i class="fa fa-align-left"></i> <%= __('buttons.format') %>
                  </button>
                </div>
                <textarea class="form-control-modern" id="respuesta" name="respuesta" rows="5" placeholder="<%= __('form.placeholder.response') %>"></textarea>
              </div>

              <!-- Destino Proxy -->
              <div class="form-group-modern" id="divDestino" style="display: none;">
                <label class="form-label-modern" for="destinoProxy"><%= __('form.proxyDestination') %></label>
                <input type="text" class="form-control-modern" id="destinoProxy" name="destinoProxy" placeholder="<%= __('form.placeholder.proxyUrl') %>">
                <small style="color: var(--text-muted); margin-top: 0.5rem; display: block;">
                  <%- __('form.help.proxyExample')
                    .replace('[route]', '<code style="color: var(--primary);">/fake-api/</code>')
                    .replace('[target]', '<code style="color: var(--primary);">https://api.example.com</code>')
                    .replace('[request]', '<code style="color: var(--primary);">/fake-api/users</code>')
                    .replace('[result]', '<code style="color: var(--primary);">https://api.example.com/users</code>')
                  %>
                </small>
              </div>

              <!-- Proxy Timeout -->
              <div class="form-group-modern" id="divProxyTimeout" style="display: none;">
                <label class="form-label-modern" for="proxyTimeout"><%= __('form.proxyTimeout') %></label>
                <div class="d-flex align-items-center gap-2">
                  <input type="number" class="form-control-modern" id="proxyTimeout" name="proxyTimeout" value="30000" min="1000" max="300000" step="1000" style="max-width: 150px;">
                  <span style="color: var(--text-secondary);">ms</span>
                </div>
                <small style="color: var(--text-muted); margin-top: 0.5rem; display: block;">
                  <%= __('form.help.proxyTimeoutHelp') %>
                </small>
              </div>

              <!-- Modo grabación -->
              <div class="alert-modern alert-modern-info" id="divProxyRecording" style="display: none;">
                <i class="fa fa-record-vinyl alert-icon" aria-hidden="true"></i>
                <div class="alert-content">
                  <div class="alert-title"><%= __('form.proxyRecording') %></div>
                  <div class="alert-text"><%= __('form.help.proxyRecordingHelp') %></div>
                  <select class="form-control-modern" id="proxyRecordingMode" name="recordingMode"
                          style="max-width: 260px; margin-top: 0.5rem;">
                    <option value="update"><%= __('form.proxyRecordingUpdate') %></option>
                    <option value="skip"><%= __('form.proxyRecordingSkip') %></option>
                  </select>
                </div>
                <label class="switch-modern" for="proxyRecording">
                  <input type="checkbox" id="proxyRecording" name="recording">
                  <span class="slider"></span>
                </label>
              </div>

              <!-- Proxy Fallbacks -->
              <div class="collapsible-section" id="divFallbacks" style="display: none; margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleFallbacksSection()">
                  <h4><i class="fa fa-life-ring"></i> <%= __('form.proxyFallbacks') %></h4>
                  <button type="button" class="btn-modern btn-modern-success" onclick="event.stopPropagation(); addFallbackRow()">
                    <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                  </button>
                </div>
                <div class="collapsible-body" style="display: none;">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.fallbacksHelp') %>
                  </small>

                  <!-- Referencia de patrones -->
                  <div class="conditions-reference">
                    <div><strong><%= __('form.pathPatterns') %>:</strong>
                      <code>.*</code> (<%= __('form.pathPatternsAll') %>),
                      <code>^/users/.*</code> (<%= __('form.pathPatternsUsers') %>),
                      <code>^/api/v1/orders/[0-9]+$</code> (<%= __('form.pathPatternsOrders') %>)
                    </div>
                  </div>

                  <!-- Contenedor de fallbacks (sortable) -->
                  <div id="fallbacksContainer" class="sortable-fallbacks">
                    <!-- Fallbacks dinamicos aqui -->
                  </div>

                  <div id="noFallbacksMsg" class="empty-state" style="padding: 1rem;">
                    <i class="fa fa-inbox"></i>
                    <p><%= __('empty.noFallbacks') %></p>
                  </div>
                </div>
              </div>

              <!-- Transformación de la petición y la respuesta (solo proxy) -->
              <div class="collapsible-section" id="divProxyTransform" style="display: none; margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleProxyTransformSection()">
                  <h4><i class="fa fa-magic"></i> <%= __('form.proxyTransform') %></h4>
                  <button type="button" class="btn-modern btn-modern-info" onclick="event.stopPropagation(); openScriptHelp()">
                    <i class="fa fa-question-circle"></i> <%= __('form.scriptApiReference') %>
                  </button>
                </div>
                <div class="collapsible-body" style="display: none;">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.proxyTransformHelp') %>
                  </small>

                  <!-- Cabeceras de la petición -->
                  <div class="form-label-row">
                    <label class="form-label-modern"><i class="fa fa-list-ul"></i> <%= __('form.requestHeaders') %></label>
                    <button type="button" class="btn-modern btn-modern-success btn-sm" onclick="addProxyHeaderRow()">
                      <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                    </button>
                  </div>
                  <div id="proxyHeadersContainer"></div>
                  <div id="noProxyHeadersMsg" class="empty-state" style="padding: 0.75rem;">
                    <p><%= __('empty.noRequestHeaders') %></p>
                  </div>

                  <!-- Parámetros de query -->
                  <div class="form-label-row" style="margin-top: 1.25rem;">
                    <label class="form-label-modern"><i class="fa fa-question"></i> <%= __('form.requestParams') %></label>
                    <button type="button" class="btn-modern btn-modern-success btn-sm" onclick="addProxyParamRow()">
                      <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                    </button>
                  </div>
                  <div id="proxyParamsContainer"></div>
                  <div id="noProxyParamsMsg" class="empty-state" style="padding: 0.75rem;">
                    <p><%= __('empty.noRequestParams') %></p>
                  </div>

                  <!-- Script de petición -->
                  <div class="form-group-modern" style="margin-top: 1.5rem;">
                    <div class="form-label-row">
                      <label class="form-label-modern" for="proxyPreScript">
                        <i class="fa fa-arrow-right"></i> <%= __('form.preScript') %>
                      </label>
                      <button type="button" class="btn-modern btn-modern-secondary btn-sm" onclick="validateProxyScript('request')">
                        <i class="fa fa-check"></i> <%= __('buttons.validate') %>
                      </button>
                    </div>
                    <textarea class="form-control-modern script-editor" id="proxyPreScript" rows="7" spellcheck="false"
                              placeholder="ms.request.headers.add({ key: 'x-api-key', value: 'abc' });"></textarea>
                    <div id="proxyPreScriptResult" class="script-validation-result"></div>
                  </div>

                  <!-- Script de respuesta -->
                  <div class="form-group-modern">
                    <div class="form-label-row">
                      <label class="form-label-modern" for="proxyPostScript">
                        <i class="fa fa-arrow-left"></i> <%= __('form.postScript') %>
                      </label>
                      <button type="button" class="btn-modern btn-modern-secondary btn-sm" onclick="validateProxyScript('response')">
                        <i class="fa fa-check"></i> <%= __('buttons.validate') %>
                      </button>
                    </div>
                    <textarea class="form-control-modern script-editor" id="proxyPostScript" rows="7" spellcheck="false"
                              placeholder="const data = ms.response.json();&#10;data.total = data.items.length;&#10;ms.response.setBody(data);"></textarea>
                    <div id="proxyPostScriptResult" class="script-validation-result"></div>
                  </div>
                </div>
              </div>

              <!-- Archivo -->
              <div class="form-group-modern" id="divFile" style="display: none;">
                <label class="form-label-modern" for="fileUpload"><%= __('form.fileToReturn') %></label>
                <div class="file-upload-wrapper">
                  <input type="file" class="form-control-modern" id="fileUpload" name="fileUpload" onchange="handleFileSelect(event)">
                  <div id="fileInfo" class="file-info" style="display: none;">
                    <i class="fa fa-file"></i>
                    <span id="fileName"></span>
                    <span id="fileSize" class="file-size"></span>
                    <button type="button" class="btn-file-remove" onclick="clearFileSelection()" title="Quitar archivo">
                      <i class="fa fa-times"></i>
                    </button>
                  </div>
                  <div id="currentFileInfo" class="current-file-info" style="display: none;">
                    <i class="fa fa-check-circle" style="color: var(--success);"></i>
                    <span>Archivo actual: </span>
                    <strong id="currentFileName"></strong>
                    <span id="currentFileSize" class="file-size"></span>
                  </div>
                </div>
                <small style="color: var(--text-muted); margin-top: 0.5rem; display: block;">
                  <%= __('form.help.fileHelp') %>
                </small>
              </div>

              <!-- GraphQL Operations -->
              <div class="collapsible-section" id="divGraphQL" style="display: none; margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleGraphQLSection()">
                  <h4><i class="fa fa-share-alt"></i> <%= __('form.graphqlOperations') %></h4>
                  <div class="d-flex gap-2" onclick="event.stopPropagation();">
                    <button type="button" class="btn-modern btn-modern-info" onclick="openGraphQLSchemaImport()">
                      <i class="fa fa-download"></i> <%= __('form.importSchema') %>
                    </button>
                    <button type="button" class="btn-modern btn-modern-success" onclick="addGraphQLOperationRow()">
                      <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                    </button>
                  </div>
                </div>
                <div class="collapsible-body" id="graphqlCollapsibleBody">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.graphqlHelp') %>
                  </small>

                  <!-- Proxy URL (visible when at least one operation uses proxy) -->
                  <div id="graphqlProxyUrlContainer" style="display: none; margin-bottom: 1rem;">
                    <div class="alert-modern alert-modern-warning" style="padding: 1rem;">
                      <div style="flex: 1;">
                        <label class="form-label-modern" for="graphqlProxyUrl">
                          <i class="fa fa-exchange"></i> <%= __('form.graphqlProxyUrl') %>
                        </label>
                        <input type="text" class="form-control-modern" id="graphqlProxyUrl"
                               placeholder="https://rickandmortyapi.com/graphql">
                        <small style="color: var(--text-muted); margin-top: 0.5rem; display: block;">
                          <%= __('form.help.graphqlProxyHelp') %>
                        </small>
                      </div>
                    </div>
                  </div>

                  <!-- Schema Import Form (hidden by default) -->
                  <div id="graphqlSchemaImportForm" style="display: none; margin-bottom: 1rem;">
                    <div class="alert-modern alert-modern-info" style="padding: 1rem;">
                      <div style="flex: 1;">
                        <label class="form-label-modern" for="graphqlSchemaUrl"><%= __('form.graphqlSchemaUrl') %></label>
                        <div class="d-flex gap-2">
                          <input type="text" class="form-control-modern" id="graphqlSchemaUrl"
                                 placeholder="https://rickandmortyapi.com/graphql">
                          <button class="btn-modern btn-modern-primary" id="btnImportSchema" onclick="importGraphQLSchema()" style="white-space: nowrap;">
                            <i class="fa fa-download"></i> <%= __('form.importSchemaBtn') %>
                          </button>
                        </div>
                        <small style="color: var(--text-muted); margin-top: 0.5rem; display: block;">
                          <%= __('form.help.graphqlSchemaHelp') %>
                        </small>
                        <div id="schemaImportProgress" style="display: none; margin-top: 0.5rem;">
                          <i class="fa fa-spinner fa-spin"></i> <span id="schemaImportStatus"></span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Contenedor de operaciones (sortable) -->
                  <div id="graphqlOperationsContainer" class="sortable-conditions">
                    <!-- Operaciones dinamicas aqui -->
                  </div>

                  <div id="noGraphQLOpsMsg" class="empty-state" style="padding: 1rem;">
                    <i class="fa fa-inbox"></i>
                    <p><%= __('empty.noGraphQLOperations') %></p>
                  </div>
                </div>
              </div>

              <!-- WebSocket Messages -->
              <div class="collapsible-section" id="divWebSocket" style="display: none; margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleWebSocketSection()">
                  <h4><i class="fa fa-plug"></i> <%= __('form.wsMessages') %></h4>
                  <div class="d-flex gap-2" onclick="event.stopPropagation();">
                    <button type="button" class="btn-modern btn-modern-success" onclick="addWSMessageRow()">
                      <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                    </button>
                  </div>
                </div>
                <div class="collapsible-body" id="wsCollapsibleBody">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.wsHelp') %>
                  </small>

                  <div id="wsMessagesContainer" class="sortable-conditions">
                    <!-- Mensajes dinamicos aqui -->
                  </div>

                  <div id="noWSMsgsMsg" class="empty-state" style="padding: 1rem;">
                    <i class="fa fa-inbox"></i>
                    <p><%= __('empty.noWSMessages') %></p>
                  </div>
                </div>
              </div>

              <!-- Espera Activa -->
              <div class="alert-modern alert-modern-warning" id="divEsperaActiva">
                <i class="fa fa-pause-circle alert-icon" aria-hidden="true"></i>
                <div class="alert-content">
                  <div class="alert-title"><%= __('form.waitMode') %></div>
                  <div class="alert-text"><%= __('form.help.waitModeDesc') %></div>
                </div>
                <label class="switch-modern" for="esperaActiva">
                  <input type="checkbox" id="esperaActiva" name="esperaActiva">
                  <span class="slider"></span>
                </label>
              </div>

              <!-- Ruta Activa -->
              <div class="alert-modern alert-modern-info" id="divActivo">
                <i class="fa fa-power-off alert-icon" aria-hidden="true"></i>
                <div class="alert-content">
                  <div class="alert-title"><%= __('form.routeActive') %></div>
                  <div class="alert-text"><%= __('form.help.routeActiveDesc') %></div>
                </div>
                <label class="switch-modern" for="rutaActiva">
                  <input type="checkbox" id="rutaActiva" name="rutaActiva" checked>
                  <span class="slider"></span>
                </label>
              </div>

              <!-- Latencia y fallos provocados -->
              <div class="collapsible-section" id="divFaults" style="margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleFaultsSection()">
                  <h4><i class="fa fa-bolt"></i> <%= __('form.faults') %></h4>
                  <span class="badge-modern" id="faultsBadge" style="display: none;"></span>
                </div>
                <div class="collapsible-body" style="display: none;">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.faultsHelp') %>
                  </small>

                  <div class="form-group-modern">
                    <label class="form-label-modern" for="latencyMode"><%= __('form.latencyMode') %></label>
                    <select class="form-control-modern" id="latencyMode" name="latencyMode"
                            onchange="updateFaultsFields()" style="max-width: 260px;">
                      <option value="none"><%= __('form.latencyNone') %></option>
                      <option value="fixed"><%= __('form.latencyFixed') %></option>
                      <option value="random"><%= __('form.latencyRandom') %></option>
                    </select>
                  </div>

                  <div class="form-group-modern" id="divLatencyValues" style="display: none;">
                    <label class="form-label-modern" for="latencyMs">
                      <span id="latencyMsLabel"><%= __('form.latencyMs') %></span>
                    </label>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <input type="number" class="form-control-modern" id="latencyMs" name="latencyMs"
                             value="0" min="0" max="60000" step="100" style="max-width: 130px;">
                      <span style="color: var(--text-secondary);">ms</span>
                      <span id="latencyMaxWrapper" style="display: none;" class="d-flex align-items-center gap-2">
                        <span style="color: var(--text-secondary);">&mdash;</span>
                        <input type="number" class="form-control-modern" id="latencyMaxMs" name="latencyMaxMs"
                               value="0" min="0" max="60000" step="100" style="max-width: 130px;">
                        <span style="color: var(--text-secondary);">ms</span>
                      </span>
                    </div>
                  </div>

                  <div class="form-group-modern">
                    <label class="form-label-modern" for="faultRate"><%= __('form.faultRate') %></label>
                    <div class="d-flex align-items-center gap-2">
                      <input type="number" class="form-control-modern" id="faultRate" name="faultRate"
                             value="0" min="0" max="100" step="5" style="max-width: 110px;"
                             onchange="updateFaultsFields()" oninput="updateFaultsFields()">
                      <span style="color: var(--text-secondary);">%</span>
                    </div>
                  </div>

                  <div id="divFaultDetail" style="display: none;">
                    <div class="form-group-modern">
                      <label class="form-label-modern" for="faultType"><%= __('form.faultType') %></label>
                      <select class="form-control-modern" id="faultType" name="faultType"
                              onchange="updateFaultsFields()" style="max-width: 320px;">
                        <option value="error"><%= __('form.faultTypeError') %></option>
                        <option value="reset"><%= __('form.faultTypeReset') %></option>
                        <option value="empty"><%= __('form.faultTypeEmpty') %></option>
                      </select>
                    </div>
                    <div class="form-group-modern" id="divFaultStatus">
                      <label class="form-label-modern" for="faultStatus"><%= __('form.faultStatus') %></label>
                      <input type="text" class="form-control-modern" id="faultStatus" name="faultStatus"
                             value="500" style="max-width: 110px;">
                    </div>
                  </div>
                </div>
              </div>

              <!-- Metadata (operationId, summary, description) -->
              <div class="collapsible-section" id="divMetadata" style="margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleMetadataSection()">
                  <h4><i class="fa fa-info-circle"></i> <%= __('form.metadata') %></h4>
                </div>
                <div class="collapsible-body">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.metadataHelp') %>
                  </small>
                  <div class="form-group-modern">
                    <label class="form-label-modern" for="operationId"><%= __('form.operationId') %></label>
                    <input type="text" class="form-control-modern" id="operationId" name="operationId" placeholder="<%= __('form.placeholder.operationId') %>">
                  </div>
                  <div class="form-group-modern">
                    <label class="form-label-modern" for="summary"><%= __('form.summary') %></label>
                    <input type="text" class="form-control-modern" id="summary" name="summary" placeholder="<%= __('form.placeholder.summary') %>">
                  </div>
                  <div class="form-group-modern">
                    <label class="form-label-modern" for="description"><%= __('form.description') %></label>
                    <textarea class="form-control-modern" id="description" name="description" rows="3" placeholder="<%= __('form.placeholder.description') %>"></textarea>
                  </div>
                  <div class="form-group-modern">
                    <div class="form-label-row">
                      <label class="form-label-modern" for="requestBodyExample"><%= __('form.requestBodyExample') %></label>
                      <button type="button" class="btn-modern btn-modern-secondary btn-sm" id="btnFormatReqBody" onclick="formatRequestBodyJson()" title="<%= __('buttons.format') %>">
                        <i class="fa fa-align-left"></i> <%= __('buttons.format') %>
                      </button>
                    </div>
                    <textarea class="form-control-modern" id="requestBodyExample" name="requestBodyExample" rows="4" placeholder="<%= __('form.placeholder.requestBodyExample') %>"></textarea>
                    <small style="color: var(--text-muted); margin-top: 0.5rem; display: block;">
                      <%= __('form.help.requestBodyHelp') %>
                    </small>
                  </div>
                </div>
              </div>

              <!-- Tags -->
              <div class="collapsible-section" id="divTags" style="margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleTagsSection()">
                  <h4><i class="fa fa-tags"></i> <%= __('form.tags') %></h4>
                  <button type="button" class="btn-modern btn-modern-success" onclick="event.stopPropagation(); TagsModule.openCreator()">
                    <i class="fa fa-plus"></i> <%= __('buttons.newTag') %>
                  </button>
                </div>
                <div class="collapsible-body">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.tagsHelp') %>
                  </small>
                  <div id="tagsSelector" class="tags-selector">
                    <!-- Tag chips will be rendered here -->
                  </div>
                  <div id="noTagsMsg" class="no-tags-msg" style="display: none;">
                    <%= __('empty.noTags') %>
                  </div>
                </div>
              </div>

              <!-- Tag Creator Popup -->
              <div id="tagCreatorPopup" class="tag-creator-popup" style="display: none;">
                <div class="tag-creator-content">
                  <label class="form-label-modern"><%= __('form.tagName') %></label>
                  <input type="text" class="form-control-modern" id="newTagName"
                    placeholder="<%= __('form.placeholder.tagName') %>"
                    oninput="TagsModule.filterSuggestions()"
                    autocomplete="off">

                  <!-- Existing tags suggestions -->
                  <div id="tagSuggestions" class="tag-suggestions">
                    <!-- Rendered by JS -->
                  </div>

                  <label class="form-label-modern" style="margin-top: 0.75rem;"><%= __('form.tagColor') %></label>
                  <small style="color: var(--text-muted); display: block; margin-bottom: 0.5rem;">
                    <%= __('form.tagColorHint') %>
                  </small>
                  <div class="color-palette" id="colorPalette">
                    <!-- Color swatches rendered by JS -->
                  </div>
                  <input type="color" id="customTagColor" class="custom-color-input" value="#6366f1">
                  <div class="tag-creator-actions">
                    <button type="button" class="btn-modern btn-modern-secondary btn-sm" onclick="TagsModule.closeCreator()">
                      <%= __('buttons.cancel') %>
                    </button>
                    <button type="button" class="btn-modern btn-modern-primary btn-sm" onclick="TagsModule.createOrAddTag()">
                      <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Headers Personalizados -->
              <div class="collapsible-section" id="divHeaders" style="margin-top: 1.25rem;">
                <div class="collapsible-header" onclick="toggleHeadersSection()">
                  <h4><i class="fa fa-list-ul"></i> <%= __('form.customHeaders') %></h4>
                  <button type="button" class="btn-modern btn-modern-success" onclick="event.stopPropagation(); addHeaderRow()">
                    <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                  </button>
                </div>
                <div class="collapsible-body">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.headersHelp') %>
                  </small>
                  <div id="headersContainer">
                    <!-- Headers dinamicos aqui -->
                  </div>
                  <div id="noHeadersMsg" class="empty-state" style="padding: 1rem;">
                    <i class="fa fa-inbox"></i>
                    <p><%= __('empty.noHeaders') %></p>
                  </div>
                </div>
              </div>
            </section>

            <!-- Seccion: Respuestas Condicionales -->
            <section class="route-section" id="conditionalResponsesSection">
              <div class="collapsible-section" id="divConditions">
                <div class="collapsible-header" onclick="toggleConditionsSection()">
                  <h4><i class="fa fa-code-fork"></i> <%= __('form.conditionalResponses') %></h4>
                  <div class="d-flex gap-2" onclick="event.stopPropagation();">
                    <button type="button" class="btn-modern btn-modern-info btn-sm" onclick="showCriteriaHelp()" title="<%= __('form.criteriaExamples') %>">
                      <i class="fa fa-question-circle"></i>
                    </button>
                    <button type="button" class="btn-modern btn-modern-success" onclick="addConditionRow()">
                      <i class="fa fa-plus"></i> <%= __('buttons.add') %>
                    </button>
                  </div>
                </div>
                <div class="collapsible-body">
                  <small style="color: var(--text-muted); margin-bottom: 1rem; display: block;">
                    <%= __('form.help.conditionsHelp') %>
                  </small>

                  <!-- Referencia de variables y funciones -->
                  <div class="conditions-reference">
                    <div><strong><%= __('form.availableVariables') %>:</strong>
                      <code>headers</code>, <code>body</code>, <code>path</code>, <code>query</code>, <code>params</code>, <code>method</code>
                    </div>
                    <div><strong><%= __('form.availableFunctions') %>:</strong>
                      <code>includes()</code>, <code>startsWith()</code>, <code>endsWith()</code>, <code>match()</code>,
                      <code>hasKey()</code>, <code>isEmpty()</code>, <code>isNotEmpty()</code>, <code>equals()</code>
                    </div>
                  </div>

                  <!-- Contenedor de condiciones (sortable) -->
                  <div id="conditionsContainer" class="sortable-conditions">
                    <!-- Condiciones dinamicas aqui -->
                  </div>

                  <div id="noConditionsMsg" class="empty-state" style="padding: 1rem;">
                    <i class="fa fa-inbox"></i>
                    <p><%= __('empty.noConditions') %></p>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-modern btn-modern-secondary" data-bs-dismiss="modal"><%= __('buttons.cancel') %></button>
        <button type="button" class="btn-modern btn-modern-primary" id="botonguardar" onclick="guardar()">
          <i class="fa fa-save"></i> <%= __('buttons.save') %>
        </button>
        <button type="button" class="btn-modern btn-modern-warning" id="botoneditar" onclick="editar()">
          <i class="fa fa-edit"></i> <%= __('buttons.update') %>
        </button>
      </div>
    </div>
  </div>
</div>
